{
  "expo": {
    "name": "ভাঙ্গারিওয়ালা",
    "slug": "bhangariwala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bhangariwala"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFC72C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bhangariwala"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "bhangariwala",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is saved with your address so the collector can find your home."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Photos of your scrap help the collector know what to expect.",
          "cameraPermission": "Take a photo of your scrap so the collector knows what to expect."
        }
      ]
    ]
  }
}
