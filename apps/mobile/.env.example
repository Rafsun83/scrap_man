# The phone must reach your computer: use its Wi-Fi IP address, not localhost.
# Android emulator: http://10.0.2.2:3000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.0.106:3000/api/v1

# Google Maps key for the H6 map and the address pin. Keep it out of git: put it in .env.local.
# Without it the app shows distance and ETA instead of a map.
GOOGLE_MAPS_API_KEY=
