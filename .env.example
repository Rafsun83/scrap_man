# Copy to apps/api/.env and adjust if needed
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://bw:bw_dev_password@localhost:5434/bhangariwala
REDIS_URL=redis://localhost:6380
# At least 32 random characters. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars
# Development only: every OTP is this code, so you can sign in without SMS. Remove for real SMS.
OTP_DEV_CODE=123456
# The first admin account, created by `pnpm db:seed`
ADMIN_PHONE=+8801700000000

# Photo storage (S3-compatible). These match the s3 service in docker-compose.yml.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=bhangariwala-photos
S3_ACCESS_KEY=bw_s3
S3_SECRET_KEY=bw_s3_dev_password
S3_FORCE_PATH_STYLE=true
# Matching jobs (radius widening and expiry) run every 15 seconds in the API process
JOBS_ENABLED=true

# End-to-end tests use their own database and Redis db so they never touch your data
TEST_DATABASE_URL=postgres://bw:bw_dev_password@localhost:5434/bhangariwala_test
TEST_REDIS_URL=redis://localhost:6380/15

# ---------------------------------------------------------------------------------------------------------------
# Production (docker-compose.prod.yml): copy this section to .env.prod at the repo root. Never commit .env.prod.
# POSTGRES_PASSWORD=change-me
# JWT_SECRET=48-random-characters-from-openssl-rand-base64-48
# ADMIN_PHONE=+8801700000000
# S3_ACCESS_KEY=bw_s3                  # the local stack's SeaweedFS uses docker/s3/s3.json; real S3/R2 keys in hosting
# S3_SECRET_KEY=bw_s3_dev_password
# S3_CREATE_BUCKET=true                # only for the self-hosted SeaweedFS
# SMS_PROVIDER=http                    # console only for local trials: OTPs then appear in the API log
# SMS_HTTP_URL=https://sms-gateway.example/send
# SMS_HTTP_API_KEY=change-me
# SMS_SENDER_ID=BhangariWala
# API_PORT=3000
# ADMIN_PORT=8080
# Logs are JSON in production (LOG_FORMAT=json); every response has an X-Request-Id that matches the log lines.
