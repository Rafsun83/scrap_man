{
  "name": "bhangariwala",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@bw/api --filter=@bw/admin",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "gen:api": "pnpm --filter @bw/shared gen:api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:mobile": "pnpm --filter @bw/mobile dev",
    "db:migrate": "pnpm --filter @bw/shared build && pnpm --filter @bw/api migration:run",
    "db:seed": "pnpm --filter @bw/shared build && pnpm --filter @bw/api db:seed",
    "test:e2e": "pnpm --filter @bw/shared build && pnpm --filter @bw/api test:e2e",
    "postinstall": "pnpm --filter @bw/shared build"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
